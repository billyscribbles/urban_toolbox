{
  "ci": {
    "collect": {
      "startServerCommand": "yarn start",
      "_comment": "Must match what server.js actually logs — it prints the bind address (0.0.0.0), never 'localhost', so the old pattern never fired and LHCI just waited out its timeout.",
      "startServerReadyPattern": "Serving dist/ on",
      "url": ["http://localhost:4173/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
